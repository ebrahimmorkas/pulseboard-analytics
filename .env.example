# ---------------------------------------------------------------------------
# Pulseboard environment configuration
# Copy this file to `.env` and adjust the values for your environment.
# ---------------------------------------------------------------------------

# Public URL of the app. The tracking script sends events to this origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL connection string (docker compose exposes this by default)
DATABASE_URL=postgres://pulseboard:pulseboard@localhost:5434/pulseboard

# Secret used to derive the daily rotating salt for anonymous visitor IDs.
# Generate one with: openssl rand -base64 32
ANALYTICS_SALT_SECRET=change-me-to-a-long-random-string

# --- Optional services -----------------------------------------------------

# Redis is OPTIONAL. When set, it powers dashboard caching, ingestion rate
# limiting and the "current visitors" counter across instances.
# When empty, in-memory implementations are used.
REDIS_URL=
# REDIS_URL=redis://localhost:6381
